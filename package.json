{
  "name": "md-todo",
  "displayName": "MD Todo",
  "description": "Markdown-based todo list manager with date tracking, notes, and archiving",
  "version": "1.6.0",
  "publisher": "theryansmith",
  "license": "MIT",
  "icon": "media/extension-icon.png",
  "author": "Ryan Smith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theryansmith/md-todo.git"
  },
  "bugs": {
    "url": "https://github.com/theryansmith/md-todo/issues"
  },
  "homepage": "https://github.com/theryansmith/md-todo#readme",
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdTodo.addItem",
        "title": "Add Todo Item",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.markDone",
        "title": "Mark Done",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.addNote",
        "title": "Add Note",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.archive",
        "title": "Archive Completed Items",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.showHistory",
        "title": "Show Git History",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.showStats",
        "title": "Show Stats",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.showRecentlyCompleted",
        "title": "Show Recently Completed",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.showRecentlyAdded",
        "title": "Show Recently Added",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.showStaleItems",
        "title": "Show Stale Items",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.clearActivityFocus",
        "title": "Clear Activity Focus",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.clearAllFocus",
        "title": "Clear All Focus",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.quickAdd",
        "title": "Quick Add at Cursor",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.addTags",
        "title": "Add/Edit Tags",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.manageTags",
        "title": "Manage Tag Definitions",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.setProject",
        "title": "Set Project",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.manageProjects",
        "title": "Manage Project Definitions",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.showProjectView",
        "title": "Show Project View",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.addUser",
        "title": "Add User",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.initialize",
        "title": "Initialize Todo File",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.setFocusUser",
        "title": "Set Focus User",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.setFocusTag",
        "title": "Set Focus Tag",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.setFocusProject",
        "title": "Set Focus Project",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.setFocusActivity",
        "title": "Set Focus Activity",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.assignFocusedUser",
        "title": "Assign Focused User to Current Todo",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.users.focusOnUser",
        "title": "Focus on User in Editor",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.users.clearFocus",
        "title": "Clear User Focus",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.users.reassignUser",
        "title": "Reassign User",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.users.markDoneFromTree",
        "title": "Mark Done",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.tags.focusOnTag",
        "title": "Focus on Tag in Editor",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.tags.clearFocus",
        "title": "Clear Tag Focus",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.tags.markDoneFromTree",
        "title": "Mark Done",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.tags.editTagsFromTree",
        "title": "Edit Tags",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.projects.focusOnProject",
        "title": "Focus on Project in Editor",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.projects.clearFocus",
        "title": "Clear Project Focus",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.projects.markDoneFromTree",
        "title": "Mark Done",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.projects.setProjectFromTree",
        "title": "Set Project",
        "category": "MD Todo"
      },
      {
        "command": "mdTodo.projects.showProjectViewFromTree",
        "title": "Show Project View",
        "category": "MD Todo"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdTodo",
          "title": "MD TODO",
          "icon": "media/icon-check-square.svg"
        }
      ]
    },
    "views": {
      "mdTodo": [
        {
          "id": "mdTodoUsers",
          "name": "MD TODO USERS",
          "icon": "media/icon-check-square.svg"
        },
        {
          "id": "mdTodoTags",
          "name": "MD TODO TAGS",
          "icon": "media/icon-check-square.svg"
        },
        {
          "id": "mdTodoProjects",
          "name": "MD TODO PROJECTS",
          "icon": "media/icon-check-square.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mdTodoUsers",
        "contents": "Open a todo file (markdown with `md-todo: true` frontmatter) to see users."
      },
      {
        "view": "mdTodoTags",
        "contents": "Open a todo file (markdown with `md-todo: true` frontmatter) to see tags."
      },
      {
        "view": "mdTodoProjects",
        "contents": "Open a todo file (markdown with `md-todo: true` frontmatter) to see projects."
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "mdTodo.users.focusOnUser",
          "when": "view == mdTodoUsers && viewItem == user",
          "group": "navigation"
        },
        {
          "command": "mdTodo.users.clearFocus",
          "when": "view == mdTodoUsers && viewItem == user",
          "group": "navigation"
        },
        {
          "command": "mdTodo.users.reassignUser",
          "when": "view == mdTodoUsers && viewItem == todo",
          "group": "1_modification"
        },
        {
          "command": "mdTodo.users.markDoneFromTree",
          "when": "view == mdTodoUsers && viewItem == todo",
          "group": "1_modification"
        },
        {
          "command": "mdTodo.tags.focusOnTag",
          "when": "view == mdTodoTags && viewItem == tag-root",
          "group": "navigation"
        },
        {
          "command": "mdTodo.tags.clearFocus",
          "when": "view == mdTodoTags && viewItem == tag-root",
          "group": "navigation"
        },
        {
          "command": "mdTodo.tags.markDoneFromTree",
          "when": "view == mdTodoTags && viewItem == tag-todo",
          "group": "1_modification"
        },
        {
          "command": "mdTodo.tags.editTagsFromTree",
          "when": "view == mdTodoTags && viewItem == tag-todo",
          "group": "1_modification"
        },
        {
          "command": "mdTodo.projects.focusOnProject",
          "when": "view == mdTodoProjects && viewItem == project-root",
          "group": "navigation"
        },
        {
          "command": "mdTodo.projects.clearFocus",
          "when": "view == mdTodoProjects && viewItem == project-root",
          "group": "navigation"
        },
        {
          "command": "mdTodo.projects.showProjectViewFromTree",
          "when": "view == mdTodoProjects && viewItem == project-root",
          "group": "navigation"
        },
        {
          "command": "mdTodo.projects.markDoneFromTree",
          "when": "view == mdTodoProjects && viewItem == project-todo",
          "group": "1_modification"
        },
        {
          "command": "mdTodo.projects.setProjectFromTree",
          "when": "view == mdTodoProjects && viewItem == project-todo",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "MD Todo",
      "properties": {
        "mdTodo.archiveAfterDays": {
          "type": "number",
          "default": 7,
          "description": "Number of days after completion before items can be archived"
        },
        "mdTodo.dateOpacity": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Opacity for date decorations like +2026-01-28 and ✓2026-01-28 (0.1-1.0)"
        },
        "mdTodo.staleAfterDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Default 'older than' threshold (in days) for the Show Stale Items command."
        }
      }
    },
    "keybindings": [
      {
        "command": "mdTodo.markDone",
        "key": "ctrl+shift+t d",
        "mac": "cmd+shift+t d",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTodo.addItem",
        "key": "ctrl+shift+t t",
        "mac": "cmd+shift+t t",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTodo.setFocusTag",
        "key": "ctrl+shift+t f",
        "mac": "cmd+shift+t f",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTodo.setFocusUser",
        "key": "ctrl+shift+t shift+f",
        "mac": "cmd+shift+t shift+f",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTodo.archive",
        "key": "ctrl+shift+t a",
        "mac": "cmd+shift+t a",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTodo.addNote",
        "key": "ctrl+shift+t n",
        "mac": "cmd+shift+t n",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTodo.addTags",
        "key": "ctrl+shift+t shift+t",
        "mac": "cmd+shift+t shift+t",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTodo.assignFocusedUser",
        "key": "ctrl+shift+t shift+u",
        "mac": "cmd+shift+t shift+u",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTodo.setProject",
        "key": "ctrl+shift+t p",
        "mac": "cmd+shift+t p",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "mdTodo.setFocusProject",
        "key": "ctrl+shift+t shift+p",
        "mac": "cmd+shift+t shift+p",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2 \"*.md\" \"Docs/**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run lint:md && npm test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.9.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.7"
  }
}
